{
  "name": "standard",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "check:env": "ts-node scripts/check-env.ts",
    "prebuild": "yarn check:env",
    "prestart:dev": "yarn check:env",

    "clean": "rm -rf dist && rm -f tsconfig.build.tsbuildinfo",
    "build:clean": "yarn clean && yarn build",

    "build": "nest build",
    "deploy": "nest deploy",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",

    "typeorm": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js",
    "typeorm:run": "yarn typeorm migration:run -d ./data-source.ts",
    "typeorm:generate": "yarn typeorm migration:generate -d ./data-source.ts",
    "typeorm:create": "yarn typeorm migration:create",
    "typeorm:revert": "yarn typeorm migration:revert -d ./data-source.ts",
    "typeorm:show": "yarn typeorm migration:show -d ./data-source.ts",

    "migration:generate": "yarn typeorm migration:generate -d ./data-source.ts",
    "migration:create": "yarn typeorm migration:create",
    "migration:run": "yarn typeorm migration:run -d ./data-source.ts",
    "migration:revert": "yarn typeorm migration:revert -d ./data-source.ts",
    "migration:show": "yarn typeorm migration:show -d ./data-source.ts",

    "db:seed": "yarn typeorm migration:run -d ./data-source.ts",

    "lint": "oxlint src/ test/",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/static": "^10.1.3",
    "@fastify/view": "^12.0.0",
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.0.1",
    "@nestjs/jwt": "^12.0.1",
    "@nestjs/mapped-types": "*",
    "@nestjs/observe": "^0.1.8",
    "@nestjs/passport": "^12.0.0",
    "@nestjs/platform-fastify": "^12.0.1",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/typeorm": "^12.0.1",
    "@types/bcrypt": "^6.0.0",
    "@types/ioredis": "^5.0.0",
    "@types/nodemailer": "^8.0.1",
    "@types/uuid": "^11.0.0",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "date-fns": "^4.4.0",
    "fastify-cookie": "^5.7.0",
    "fastify-helmet": "^7.1.0",
    "ioredis": "^6.0.0",
    "nodemailer": "^9.1.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^1.1.1",
    "uuid": "^14.0.2"
  },
  "devDependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/helmet": "^13.1.1",
    "@nestjs/cli": "^12.0.0",
    "@nestjs/mau": "^0.2.6",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.4.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^7.0.0",
    "jest": "^30.0.0",
    "oxlint": "^1.58.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6.0.2"
  }
}
